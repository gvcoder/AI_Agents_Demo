# ==============================================================================
# AI Agent Design Patterns - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Primary LLM API Keys (fill the ones you have available)
# ------------------------------------------------------------------------------

# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Get at: https://platform.openai.com/)
OPENAI_API_KEY=

# Anthropic Claude API Key (Get at: https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Local Model Configuration (Ollama & Docker Model Runner)
# ------------------------------------------------------------------------------
# Default Ollama local endpoint
OLLAMA_BASE_URL=http://localhost:11434
# Default model name for Ollama when testing locally (e.g. llama3.2, qwen2.5, mistral)
OLLAMA_DEFAULT_MODEL=llama3.2

# Docker Model Runner / vLLM / LocalAI endpoint (if running)
LOCAL_LLM_ENDPOINT=http://localhost:8000/v1

# ------------------------------------------------------------------------------
# Default Testing Model Provider: "gemini" | "openai" | "anthropic" | "ollama"
# ------------------------------------------------------------------------------
DEFAULT_PROVIDER=gemini

